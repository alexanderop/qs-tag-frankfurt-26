{
  "name": "slidev-starter",
  "version": "1.0.0",
  "description": "Slidev starter template with @alexop theme and addon",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev",
    "build": "slidev build",
    "export": "slidev export",
    "export:pdf": "slidev export --format pdf",
    "export:png": "slidev export --format png",
    "research:check": "node scripts/check-research.mjs",
    "research:test": "node --test scripts/check-research.test.mjs",
    "export:pptx": "slidev export --format pptx-editable --with-clicks false"
  },
  "dependencies": {
    "@alexop/slidev-addon-utils": "workspace:*",
    "@alexop/slidev-theme-brand": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "^53.1.0",
    "playwright-chromium": "^1.65.0",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1",
    "workbox-window": "^7.4.1"
  }
}
